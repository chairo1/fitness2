# Copy to apps/web/.env.local for `pnpm --filter web dev`.
# API_PORT in the root .env defaults to 3000; 3002 is only a local override
# for when 3000 is busy. Keep the ports below equal to your root API_PORT.
ADMIN_HOST=admin.localhost
API_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:3000
