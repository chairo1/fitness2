DATABASE_URL=postgresql://fitness:fitness@localhost:5432/fitness

# API auth
# Required: the API refuses to start without it. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
# Set to true in production (HTTPS) so the session cookie gets the Secure flag.
COOKIE_SECURE=false
# Max register requests and max login requests (each counted separately) per IP per window. Default 10.
THROTTLE_AUTH_LIMIT=10
# Throttle window in seconds. Default 900 (15 min).
THROTTLE_AUTH_TTL_SEC=900
