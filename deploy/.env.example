# Copy to /opt/fitness2/.env and fill in. Never commit the real file.
TAG=latest
GHCR_OWNER=chairo1
WEB_HOST=fit2.chairops.online
ADMIN_HOST=ad2.chairops.online
# Use a long random value without special URL characters (openssl rand -hex 24)
POSTGRES_PASSWORD=change-me
# Password here must equal POSTGRES_PASSWORD
DATABASE_URL=postgresql://fitness:change-me@db:5432/fitness
# openssl rand -hex 32
JWT_SECRET=change-me-long-random
COOKIE_SECURE=true
